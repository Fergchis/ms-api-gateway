# Firebase Admin SDK JSON en una sola línea.
# No pegar credenciales reales aquí.
FIREBASE_CONFIG=

# URI del microservicio de gestión académica.
# Local sin Docker: http://localhost:8081
# Docker: http://ms-gestion-academica:8081
GESTION_ACADEMICA_URI=http://ms-gestion-academica:8081

# URI del microservicio de asistencia.
# Local sin Docker: http://localhost:3000
# Docker: http://ms-asistencia:3000
ASISTENCIA_URI=http://ms-asistencia:3000
